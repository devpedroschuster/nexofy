# supabase link --project-ref <ref-de-producao> --password "$SUPABASE_DB_PASSWORD"
SUPABASE_DB_PASSWORD=""

# Opcional, DSN do Sentry (deixe em branco pra desabilitar em dev)
VITE_SENTRY_DSN=""
