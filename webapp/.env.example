VITE_SUPABASE_URL="https://SEU_PROJETO_STAGING.supabase.co"
VITE_SUPABASE_ANON_KEY="sua-anon-key-do-projeto-staging"
VITE_API_URL="https://SEU_PROJETO_STAGING.supabase.co/functions/v1"

# Opcional, só pra testar localmente sem escolher um estúdio pela URL:
VITE_DEV_SLUG="slug-de-um-estudio-existente"

# Opcional, só necessária quando você for deliberadamente promover uma
# migration já testada em staging para produção via CLI:
# supabase link --project-ref <ref-de-producao> --password "$SUPABASE_DB_PASSWORD"
SUPABASE_DB_PASSWORD=""

# Opcional, DSN do Sentry (deixe em branco pra desabilitar em dev/staging).
# PED-141: usar o MESMO DSN em produção e staging mistura os eventos dos
# dois ambientes num único projeto Sentry. Deixe em branco localmente e em
# staging; configure só na Vercel, escopado à env "Production".
VITE_SENTRY_DSN=""

# Ambiente reportado ao Sentry (production / preview / etc). Setar por
# ambiente na Vercel — import.meta.env.MODE NÃO serve pra isso, pois vale
# "production" em qualquer `vite build`, inclusive previews e staging.
VITE_SENTRY_ENVIRONMENT=""

# PED-149: token de build (NÃO prefixado com VITE_ — não é exposto ao
# client, só lido em vite.config.js durante o build) usado pelo
# @sentry/vite-plugin pra subir source maps e apagá-los do dist/ depois.
# Igual ao VITE_SENTRY_DSN: configure só no ambiente de Production da
# Vercel, nunca aqui/local nem em Preview — sem ele, o build local/CI/
# Preview simplesmente não gera sourcemap nenhum (comportamento atual,
# inalterado). Precisa dos scopes `project:releases` e `org:read`
# (Sentry → User Settings → Auth Tokens), org "dev-pedro-schuster",
# projeto "nexofy-web".
SENTRY_AUTH_TOKEN=""
